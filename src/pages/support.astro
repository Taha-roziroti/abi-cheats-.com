---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/support/');
const breadcrumbs = [
  { name: 'ABI cheats home', path: '/' },
  { name: 'Support', path: '/support/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  logoAlt="Support — site logo"
  jsonLd={[
    webPageSchema({
      name: t.support.title,
      description: t.support.subtitle,
      url: '/support/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/20 py-8 md:py-10">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </section>

  <ContactSupportSection titleId="support-page-title" showTicketTips />

  <section class="border-t border-border bg-muted/10 py-12 md:py-16">
    <div class="mx-auto max-w-3xl space-y-4 px-5 text-center text-sm leading-relaxed text-muted-foreground">
      <p class="text-lg font-semibold text-foreground">Before you contact support</p>
      <p>
        Confirm the listed offers match your order: <strong>$35 monthly</strong> (30-day) or <strong>$150 lifetime</strong> cheat access, plus optional <strong>$50 lifetime Cloud DMA</strong> and HWID utilities—each product uses its own checkout link.
      </p>
      <p>
        Common answers live in the <a href="/faq/" class="text-primary underline underline-offset-2">pre-purchase FAQ</a> and the <a href="/guides/cloud-dma-setup/" class="text-primary underline underline-offset-2">Hyper-V setup guide</a>. Email <a href="mailto:support@abi-cheats.com" class="text-primary underline underline-offset-2">support@abi-cheats.com</a> with your order email, Windows build, and exact loader or Hyper-V error text.
      </p>
    </div>
  </section>
</BaseLayout>
